  (text "PW package: 0.5 A RMS per bridge at VM=5 V, 25 C." (at 139.7 152.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64f6dc98-65f6-54b1-8feb-c2ea0511dfea"))
  (text "Not the 1.5 A thermally enhanced PWP/RTY versions." (at 139.7 154.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e6b85380-5226-5556-8905-b0edabcc9616"))
  (text "0.4 mm outputs; verify temperature and stall current" (at 139.7 157.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d0ca4796-fcf8-5519-9852-2d322c508df9"))
  (text "for the actual motor. OCP is not a 0.5 A limiter." (at 139.7 160.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5298037d-f518-55ea-b296-4a19974ac0ee"))
  (text "C1 100 uF / 25 V bulk on a rail that can reach 10.8 V -" (at 33.02 114.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c8aeed6d-b21f-53f0-9896-0f6699936275"))
  (text "C2 10 uF / 25 V ceramic is the local VM bypass." (at 33.02 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "969cea0a-168c-548c-a8bb-540742bd9a33"))
  (text "VM indicator: about 1.5 mA at VM=9 V." (at 116.84 127.0 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0dd43414-97af-521c-b08a-1c741c41d3fa"))
  (text "C3 10 nF: the charge-pump flying capacitor" (at 88.9 68.58 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "dd420591-2ac4-5b39-b7c9-a6a1524f9da4"))
  (text "between VM and VCP - the datasheet's value." (at 88.9 71.12 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e31dda3f-bd43-52f9-b29b-27b3157f6a4e"))
  (text "C4 2.2 uF bypasses VINT; no external load." (at 172.72 50.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c3435ed2-f027-5edf-bbde-e9feafa3eba8"))
  (text "nFAULT needs a host-side 10k pull-up to 3.3 V." (at 172.72 53.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "bd606201-fb52-55f3-9c5b-7a945ce392a7"))
  (text "AISEN/BISEN grounded: PWM current regulation" (at 190.5 124.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "035db183-ec37-54c0-a0c7-9261529961ed"))
  (text "disabled; OCP is fault protection, not regulation." (at 190.5 127.0 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "99b8d65f-8462-5f58-aa50-9a6a55d377c9"))
  (text "A lands on J2 reversed, B on J3 straight -" (at 190.5 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "48b68bee-2a1a-52d0-931b-23cd357b7039"))
  (text "the package brings them out that way." (at 190.5 132.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a1195a9a-0fea-5d56-8a6c-fecfa04c9c8b"))
  (text "Logic header in track-arrival order:" (at 33.02 157.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "60c36880-1d95-5dc6-8941-111c4c7adb5f"))
