  (text "PW package: 0.5 A RMS per bridge at VM=5 V, 25 C." (at 17.78 105.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64f6dc98-65f6-54b1-8feb-c2ea0511dfea"))
  (text "Not the 1.5 A thermally enhanced PWP/RTY versions." (at 17.78 109.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e6b85380-5226-5556-8905-b0edabcc9616"))
  (text "0.4 mm outputs; verify temperature and stall current" (at 17.78 113.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d0ca4796-fcf8-5519-9852-2d322c508df9"))
  (text "for the actual motor. OCP is not a 0.5 A limiter." (at 17.78 117.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5298037d-f518-55ea-b296-4a19974ac0ee"))
  (text "C1 100 uF / 25 V bulk on a rail that can reach 10.8 V -" (at 15.24 97.79 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c8aeed6d-b21f-53f0-9896-0f6699936275"))
